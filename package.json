{
  "name": "agent-maintenance",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "description": "Capability-gated agent session inventory and maintenance",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <27"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.cli.config.ts && tsup --config tsup.server.config.ts && node scripts/copy-gui-assets.mjs",
    "prepare": "npm run build",
    "test:bundle": "node scripts/test-built-api.mjs",
    "tui": "node --experimental-strip-types src/tui/cli.ts",
    "gui": "node --experimental-strip-types src/gui/launch-cli.ts",
    "inventory": "node --experimental-strip-types src/cli.ts inventory --json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node scripts/test-platform.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "smol-toml": "^1.9.0",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "fs-ext@2.1.1": true
  },
  "optionalDependencies": { "fs-ext": "^2.1.1" },
  "bin": { "agent-maintenance": "bin/agent-maintenance.js" },
  "files": ["bin/", "dist/", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  }
}
